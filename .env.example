# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# 1. Identity Service
IDENTITY_DB_NAME=identity_db
IDENTITY_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${IDENTITY_DB_NAME}

# 2. Product Service
PRODUCT_DB_NAME=product_db
PRODUCT_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${PRODUCT_DB_NAME}

# 3. Order Service
ORDER_DB_NAME=order_db
ORDER_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${ORDER_DB_NAME}

# 4. Payment Service
PAYMENT_DB_NAME=payment_db
PAYMENT_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${PAYMENT_DB_NAME}

# 5. Notification Service
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${NOTIFICATION_DB_NAME}

# --- Port cua tung service ---
GATEWAY_PORT=8080
IDENTITY_PORT=8081
PRODUCT_PORT=8082
ORDER_PORT=8083
PAYMENT_PORT=8084
NOTIFICATION_PORT=8085
PRODUCT_GRPC_PORT=9082
PRODUCT_GRPC_HOST=localhost

# --- Gateway Route URIs ---
IDENTITY_URI=http://localhost:8081
PRODUCT_URI=http://localhost:8082
ORDER_URI=http://localhost:8083

# --- Redis & RabbitMQ Connections ---
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}

# --- JWT Configuration ---
# Secret toi thieu 256 bit cho thuat toan HS256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Access token: 15 phut = 900000 ms
JWT_ACCESS_TOKEN_EXPIRATION=900000
# Refresh token: 7 ngay = 604800000 ms
JWT_REFRESH_TOKEN_EXPIRATION=604800000
