# Mau bien moi truong. Tao file .env (KHONG commit) bang:
#   if (-not (Test-Path .env)) { Copy-Item .env.example .env }
# Bien de trong -> docker-compose dung gia tri mac dinh trong docker-compose.yml.
# Chay service bang gradle bootRun (ngoai Docker) thi phai dien day du (*_HOST=localhost...).
# KHONG dien mat khau / secret that vao file nay: file nay nam trong git.

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_MGMT_PORT=

# 1. Identity Service
IDENTITY_DB_NAME=
IDENTITY_DATASOURCE_URL=

# 2. Product Service
PRODUCT_DB_NAME=
PRODUCT_DATASOURCE_URL=

# 3. Order Service
ORDER_DB_NAME=
ORDER_DATASOURCE_URL=
ORDER_RESERVATION_TTL_MINUTES=
ORDER_EXPIRY_CHECK_INTERVAL_MS=

# 4. Payment Service
PAYMENT_DB_NAME=
PAYMENT_DATASOURCE_URL=

# 5. Notification Service
NOTIFICATION_DB_NAME=
NOTIFICATION_DATASOURCE_URL=

# --- Port cua tung service ---
GATEWAY_PORT=
IDENTITY_PORT=
PRODUCT_PORT=
ORDER_PORT=
PAYMENT_PORT=
NOTIFICATION_PORT=
PRODUCT_GRPC_PORT=
PRODUCT_GRPC_HOST=

# --- Gateway Route URIs ---
IDENTITY_URI=
PRODUCT_URI=
ORDER_URI=
PAYMENT_URI=
PAYMENT_PUBLIC_BASE_URL=

# --- JWT Configuration ---
# Secret toi thieu 256 bit cho thuat toan HS256
JWT_SECRET=
# Access token: 15 phut = 900000 ms
JWT_ACCESS_TOKEN_EXPIRATION=
# Refresh token: 7 ngay = 604800000 ms
JWT_REFRESH_TOKEN_EXPIRATION=

# --- Payment Webhook Secret ---
PAYMENT_WEBHOOK_SECRET=

# --- VNPAY sandbox (tuy chon) ---
# Dang ky mien phi: https://sandbox.vnpayment.vn/devreg/ -> email gui TMN code + hash secret.
# De trong thi chi dung duoc thanh toan MOCK.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Trinh duyet quay ve day sau khi tra tien (qua gateway). VPS: https://<domain>/api/v1/payments/vnpay/return
VNPAY_RETURN_URL=

# --- Email (notification-service -> Mailpit) ---
# false: chi ghi log [EMAIL GIA LAP], khong gui SMTP (nen tat khi load test)
MAIL_ENABLED=
MAIL_HOST=
MAIL_PORT=
# --- Gui email that (tuy chon). De trong = dung Mailpit (local/demo) ---
# Gmail: bat xac minh 2 buoc -> https://myaccount.google.com/apppasswords tao App Password 16 ky tu.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_AUTH=true  SMTP_STARTTLS=true
#   SMTP_USERNAME=<gmail>     SMTP_PASSWORD=<app password>   MAIL_FROM=<gmail>
# Brevo (300 thu/ngay mien phi): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, user/key trong trang SMTP & API
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
MAIL_FROM=
MAIL_FROM_NAME=
# Link "Xem don hang" trong email (VPS: https://huyecommerce.duckdns.org)
APP_PUBLIC_URL=

# --- Rate limit cua gateway (token/giay theo user hoac IP) ---
# Chi nang khi load test (vd 200/400), xong thi xoa de ve mac dinh.
RATE_LIMIT_REPLENISH=
RATE_LIMIT_BURST=
RATE_LIMIT_LOGIN_REPLENISH=
RATE_LIMIT_LOGIN_BURST=

# --- Cong cu demo (Mailpit, Prometheus, Grafana) ---
MAILPIT_UI_PORT=
MAILPIT_SMTP_PORT=
PROMETHEUS_PORT=
GRAFANA_PORT=
# Bat buoc doi tren VPS; chi duoc doc o lan Grafana khoi dong dau tien
GRAFANA_ADMIN_PASSWORD=

# --- Anh san pham ---
# De trong = luu tren volume product_uploads (product-service). Co gia tri = luu tren Cloudinary (CDN).
# Lay o Cloudinary Console -> Dashboard -> "API environment variable" (copy nguyen dong).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=
