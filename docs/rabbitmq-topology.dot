// Nguon cua docs/rabbitmq-topology.png. Render lai (tu thu muc goc repo):
//   docker run --rm -v "${PWD}/docs:/d" -w /d alpine:3.20 sh -c \
//     "apk add -q graphviz ttf-dejavu && dot -Tpng -Gdpi=150 rabbitmq-topology.dot -o rabbitmq-topology.png"

digraph rabbitmq_topology {
  graph [rankdir=LR, fontname="DejaVu Sans", nodesep=0.35, ranksep=0.9, pad=0.3, bgcolor="white",
         label=<<b>RabbitMQ topology</b>  <font point-size="10">— outbox relay (SKIP LOCKED, nhiều instance) → exchange (topic) → queue → consumer; mỗi queue có DLX/DLQ riêng</font>>,
         labelloc=t, fontsize=16];
  node  [fontname="DejaVu Sans", fontsize=10.5, style="rounded,filled", penwidth=1.3, margin="0.15,0.08"];
  edge  [fontname="DejaVu Sans", fontsize=9, penwidth=1.5, arrowsize=0.75];

  // ---- Publisher ----
  node [shape=box, fillcolor="#F8FAFC", color="#334155"];
  pub_order   [label=<<b>order-service</b><br/><font point-size="8.5">outbox relay · publisher confirm</font>>];
  pub_payment [label=<<b>payment-service</b><br/><font point-size="8.5">outbox relay · publisher confirm</font>>];
  pub_product [label=<<b>product-service</b><br/><font point-size="8.5">outbox relay · publisher confirm</font>>];

  // ---- Exchange (topic) ----
  node [shape=hexagon, fillcolor="#FFEDD5", color="#C2410C", style="filled"];
  ex_order   [label=<<b>order.events</b><br/><font point-size="8.5">topic · durable</font>>];
  ex_payment [label=<<b>payment.events</b><br/><font point-size="8.5">topic · durable</font>>];
  ex_product [label=<<b>product.events</b><br/><font point-size="8.5">topic · durable</font>>];

  // ---- Queue ----
  node [shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#15803D"];
  q_notif   [label=<<b>notification.order-events</b><br/><font point-size="8.5">durable · có DLX riêng</font>>];
  q_payment [label=<<b>payment.order-events</b><br/><font point-size="8.5">durable · có DLX riêng</font>>];
  q_order   [label=<<b>order.payment-events</b><br/><font point-size="8.5">durable · có DLX riêng</font>>];
  q_product [label=<<b>order.product-events</b><br/><font point-size="8.5">durable · có DLX riêng</font>>];

  // ---- DLX (fanout) + DLQ ----
  node [shape=hexagon, style="filled", fillcolor="#FEE2E2", color="#B91C1C", fontsize=9];
  dlx_notif   [label="notification.order-events.dlx\nfanout"];
  dlx_payment [label="payment.order-events.dlx\nfanout"];
  dlx_order   [label="order.payment-events.dlx\nfanout"];
  dlx_product [label="order.product-events.dlx\nfanout"];
  node [shape=box, style="rounded,filled", fillcolor="#FEF2F2", color="#B91C1C", fontsize=9];
  dlq_notif   [label="notification.order-events.dlq"];
  dlq_payment [label="payment.order-events.dlq"];
  dlq_order   [label="order.payment-events.dlq"];
  dlq_product [label="order.product-events.dlq"];

  // ---- Consumer ----
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#334155", fontsize=10.5];
  c_notif   [label=<<b>notification-service</b><br/><font point-size="8.5">idempotent (processed_messages)<br/>lưu thông báo + gửi email</font>>];
  c_payment [label=<<b>payment-service</b><br/><font point-size="8.5">tạo payment / đánh dấu needs_refund</font>>];
  c_order   [label=<<b>order-service</b><br/><font point-size="8.5">CONFIRMED + bán kho<br/>hoặc CANCELLED + trả kho</font>>];
  c_product [label=<<b>order-service</b><br/><font point-size="8.5">tạo dòng kho rỗng cho SKU mới<br/>(ON CONFLICT DO NOTHING)</font>>];

  // ---- Luong chinh ----
  edge [color="#334155"];
  pub_order   -> ex_order   [label="publish"];
  pub_payment -> ex_payment [label="publish"];
  pub_product -> ex_product [label="publish"];

  edge [color="#C2410C", fontcolor="#9A3412"];
  ex_order   -> q_notif   [label="order.created · confirmed\ncancelled · shipped · completed"];
  ex_order   -> q_payment [label="order.created\norder.cancelled"];
  ex_payment -> q_order   [label="payment.succeeded\npayment.failed"];
  ex_product -> q_product [label="product.sku.created"];

  edge [color="#15803D", fontcolor="#166534"];
  q_notif   -> c_notif   [label="consume"];
  q_payment -> c_payment [label="consume"];
  q_order   -> c_order   [label="consume"];
  q_product -> c_product [label="consume"];

  // ---- Dead letter ----
  edge [color="#B91C1C", fontcolor="#991B1B", style=dashed];
  q_notif   -> dlx_notif   [label="reject sau\n3 lần thử"];
  q_payment -> dlx_payment [label="reject sau\n3 lần thử"];
  q_order   -> dlx_order   [label="reject sau\n3 lần thử"];
  q_product -> dlx_product [label="reject sau\n3 lần thử"];
  edge [style=solid, label=""];
  dlx_notif   -> dlq_notif;
  dlx_payment -> dlq_payment;
  dlx_order   -> dlq_order;
  dlx_product -> dlq_product;

  { rank=same; q_notif; q_payment; q_order; q_product; }
  { rank=same; dlx_notif; dlx_payment; dlx_order; dlx_product; c_notif; c_payment; c_order; c_product; }
}
