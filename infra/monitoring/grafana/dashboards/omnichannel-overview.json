        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (job) (hikaricp_connections_active)",
          "legendFormat": "{{job}}"
        },
        {
          "datasource": {
            "type": "prometheus",
