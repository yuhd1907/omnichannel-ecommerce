                ]
              }
            }
          ]
        },
        {
          "name": "SM12 Webhook SUCCESS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Signature",
                "value": "{{signature}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/webhooks/payments/mock",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "webhooks",
                "payments",
                "mock"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Body webhook + chu ky HMAC-SHA256 (hex) tinh tren dung chuoi body se gui.",
                  "const secret = pm.environment.get(\"webhookSecret\") || pm.collectionVariables.get(\"webhookSecret\");",
                  "if (!secret) { throw new Error(\"Chua dat bien webhookSecret trong environment\"); }",
                  "const body = JSON.stringify({",
                  "  orderId: pm.collectionVariables.get(\"orderId\"),",
                  "  gatewayTxnId: \"TXN-SUCCESS-\" + Date.now(),",
                  "  status: \"SUCCESS\",",
                  "  amount: Number(pm.collectionVariables.get(\"orderAmount\"))",
                  "});",
                  "pm.collectionVariables.set(\"webhookBody\", body);",
                  "pm.collectionVariables.set(\"signature\", CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().data;",
                  "console.log(\"webhook result =\", r && r.result);",
                  "pm.test(\"result = PROCESSED\", () => pm.expect(r.result).to.eql(\"PROCESSED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "SM13 Kiem tra don -> CONFIRMED/PAID (doi 4s)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/orders/{{orderId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Neu van PENDING: relay/consumer chua kip xu ly. Doi vai giay roi Send lai.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 4000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "console.log(\"Order\", d.id, \"status =\", d.status, \"paymentStatus =\", d.paymentStatus);",
                  "pm.test(\"status = CONFIRMED\", () => pm.expect(d.status).to.eql(\"CONFIRMED\"));",
                  "pm.test(\"paymentStatus = PAID\", () => pm.expect(d.paymentStatus).to.eql(\"PAID\"));"
                ]
              }
            }
          ]
        }
      ]
    },
