            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Smoke Admin\",\n  \"phone\": \"0900000002\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const email = pm.collectionVariables.get(\"adminEmail\");",
                  "console.log(\"=== SM03: chay lenh nay tren VPS (hoac local) de cap quyen ADMIN ===\");",
                  "console.log(\"docker exec -it ecommerce-postgres psql -U postgres -d identity_db -c \\\"insert into user_roles (user_id, role_id) select u.id, r.id from users u, roles r where u.email = '\" + email + \"' and r.name = 'ADMIN' on conflict do nothing;\\\"\");"
                ]
              }
            }
          ]
        }
