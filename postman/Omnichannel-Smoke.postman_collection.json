                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/auth/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Smoke User\",\n  \"phone\": \"0900000001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Moi lan chay folder 1 sinh email moi -> khong bi 409 EMAIL_EXISTS.",
                  "const runId = Date.now();",
                  "pm.collectionVariables.set(\"runId\", runId);",
                  "pm.collectionVariables.set(\"userEmail\", \"smoke-\" + runId + \"@test.com\");",
                  "pm.collectionVariables.set(\"adminEmail\", \"smoke-admin-\" + runId + \"@test.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "console.log(\"userEmail =\", pm.collectionVariables.get(\"userEmail\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "SM02 Dang ky admin",
          "request": {
            "method": "POST",
            "header": [
              {
